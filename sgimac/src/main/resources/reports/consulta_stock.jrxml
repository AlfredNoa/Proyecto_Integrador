<?xml version='1.0' encoding='UTF-8'?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="consulta_stock" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="790" leftMargin="26" rightMargin="26" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
  <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" pdfEncoding="Identity-H" isPdfEmbedded="true" />
  <parameter name="FECHA" class="java.lang.String" />
  <parameter name="USUARIO" class="java.lang.String" />
  <parameter name="FILTROS" class="java.lang.String" />
  <parameter name="RESUMEN" class="java.lang.String" />
  <parameter name="LOGO" class="java.io.InputStream" />
  <field name="insumo" class="java.lang.String" /><field name="categoria" class="java.lang.String" /><field name="stock" class="java.lang.String" /><field name="minimo" class="java.lang.String" /><field name="faltante" class="java.lang.String" /><field name="unidad" class="java.lang.String" /><field name="vencido" class="java.lang.String"/><field name="utilizable" class="java.lang.String"/><title>
    <band height="105">
      <staticText>
        <reportElement x="75" y="0" width="715" height="26" />
        <textElement verticalAlignment="Middle">
          <font size="17" isBold="true" />
        </textElement>
        <text>Hospital José Agurto Tello</text>
      </staticText>
      <staticText>
        <reportElement x="75" y="29" width="715" height="23" />
        <textElement verticalAlignment="Middle">
          <font size="13" isBold="true" />
        </textElement>
        <text>Consulta 03 · Insumos con stock bajo por categoría</text>
      </staticText>
      <textField>
        <reportElement x="0" y="55" width="790" height="20" />
        <textElement verticalAlignment="Middle">
          <font size="9" />
        </textElement>
        <textFieldExpression>"Fecha de consulta: " + $P{FECHA} + "   |   Generado por: " + $P{USUARIO}</textFieldExpression>

  <detail><band height="42" splitType="Stretch"><textField textAdjust="StretchHeight"><reportElement x="0" y="0" width="190" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{insumo}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="190" y="0" width="140" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{categoria}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="330" y="0" width="75" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{stock}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="405" y="0" width="65" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{vencido}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="470" y="0" width="75" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{utilizable}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="545" y="0" width="65" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{minimo}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="610" y="0" width="65" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{faltante}</textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement x="675" y="0" width="115" height="40"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression>$F{unidad}</textFieldExpression></textField></band></detail>
